{
  "name": "vipi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tailscale-first Swift chat client and host bridge for live Pi tmux sessions",
  "keywords": ["pi-package", "pi", "ios", "swiftui", "tailscale", "remote-control"],
  "license": "MIT",
  "scripts": {
    "host": "tsx host/src/server.ts",
    "host:check": "tsc --noEmit -p host/tsconfig.json",
    "check": "npm run host:check"
  },
  "pi": {
    "extensions": ["./extension/index.ts"]
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.20.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
